{
  "name": "@repo/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate-schema": "better-auth generate --config src/index.ts --output ../db/src/schema/auth.ts -y"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@sinclair/typebox": "^0.34.49",
    "better-auth": "^1.7.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.4.0"
  }
}
