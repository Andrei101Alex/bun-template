PORT=3001
# Comma-separated; defaults to the dashboard and website dev servers
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# pglite://<dir> needs no Postgres installed; pglite://memory is what tests use.
# Point at a real server with postgres://user:password@host:5432/database
DATABASE_URL=pglite://./.data
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# memory keeps sent mail in process and is what dev and test use; resend sends for real
EMAIL_PROVIDER=memory
# Both required when EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Support <support@example.com>
# 32+ random characters; rotating it signs everyone out. openssl rand -base64 32
BETTER_AUTH_SECRET=
# This api's own origin, which auth builds its callback and cookie URLs from
BETTER_AUTH_URL=http://localhost:3001
