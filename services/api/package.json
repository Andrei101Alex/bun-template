{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/entrypoints/api/app.ts",
  "types": "src/entrypoints/api/app.ts",
  "exports": {
    ".": {
      "types": "./src/entrypoints/api/app.ts",
      "import": "./src/entrypoints/api/app.ts"
    }
  },
  "scripts": {
