    "@repo/email": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/jobs": "workspace:*",
    "@repo/observability": "workspace:*",
    "@sinclair/typebox": "^0.34.49",
    "drizzle-orm": "^0.44.0",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.4.0"
  }
